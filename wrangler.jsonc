{
  "name": "tomato-pomodoro",
  "main": "worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "POMODORO_KV", "id": "783ccddb02694cd493c9680dd0e2ec7d" }
  ]
}
